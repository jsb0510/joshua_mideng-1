# Anthropic API key (console.anthropic.com). This app calls Claude with
# YOUR key on the server, so viewers never need their own Claude account.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared passcode you hand out to the limited group of people you're
# distributing this to. Anyone without it is redirected to /login.
ACCESS_PIN=change-me

# Optional: override the models used (defaults shown below).
# MODEL_PASSAGE=claude-sonnet-5
# MODEL_PROBLEMS=claude-sonnet-5
